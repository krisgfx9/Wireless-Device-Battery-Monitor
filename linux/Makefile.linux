# Linux (Fedora / Ubuntu) build. Kept separate from the Windows Makefile so the existing
# MinGW build stays untouched. GTK4/GIO provide the StatusNotifierItem tray icon; HID access goes
# straight to hidraw, so no extra HID library is needed.
#
# Fedora:   sudo dnf install gcc-c++ make gtk4-devel cairo-devel
# Ubuntu:   sudo apt install g++ make libgtk-4-dev libcairo2-dev
#
# ./build-linux.sh          (from the repository root; same as: make -f linux/Makefile.linux)
# ./build-linux.sh clean

CXX      ?= g++
PKGCONFIG ?= pkg-config
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wno-missing-field-initializers
GTK_CFLAGS := $(shell $(PKGCONFIG) --cflags gtk4 cairo)
GTK_LIBS   := $(shell $(PKGCONFIG) --libs gtk4 cairo)

# Phase 1: famous vendors whose drivers only need the portable HID API.
DRIVERS := \
    src/drivers/glorious.cpp \
    src/drivers/kysona.cpp \
    src/drivers/logitech.cpp \
    src/drivers/razer.cpp \
    src/drivers/steelseries.cpp \
    src/drivers/corsair.cpp \
    src/drivers/hyperx.cpp \
    src/drivers/playstation.cpp \
    src/drivers/coolermaster.cpp \
    src/drivers/finalmouse.cpp

PREFIX   ?= $(HOME)/.local

SRC := src/linux/hid_linux.cpp src/linux/devices_linux.cpp src/linux/i18n_linux.cpp src/linux/main_linux.cpp $(DRIVERS)
OBJ := $(patsubst src/%.cpp,build/linux/%.o,$(SRC))
TARGET := wireless-battery

$(TARGET): $(OBJ)
	$(CXX) $^ -o $@ $(GTK_LIBS) -pthread

build/linux/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(GTK_CFLAGS) -c $< -o $@

test:
	@mkdir -p build/linux
	$(CXX) $(CXXFLAGS) tests/linux_hid_test.cpp -o build/linux/linux_hid_test
	./build/linux/linux_hid_test
	$(CXX) $(CXXFLAGS) tests/json_output_test.cpp -o build/linux/json_output_test
	./build/linux/json_output_test
	$(CXX) $(CXXFLAGS) -DTEST_LINUX_I18N -Isrc tests/i18n_core_test.cpp src/linux/i18n_linux.cpp -o build/linux/i18n_core_test
	./build/linux/i18n_core_test

install: $(TARGET)
	install -Dm755 $(TARGET) $(DESTDIR)$(PREFIX)/bin/$(TARGET)
	install -d $(DESTDIR)$(PREFIX)/share/wireless-battery/lang
	install -m644 lang/*.json $(DESTDIR)$(PREFIX)/share/wireless-battery/lang/
	install -Dm644 linux/wireless-battery.desktop $(DESTDIR)$(PREFIX)/share/applications/wireless-battery.desktop
	install -Dm644 linux/wireless-battery.svg $(DESTDIR)$(PREFIX)/share/icons/hicolor/scalable/apps/wireless-battery.svg

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/$(TARGET)
	rm -rf $(DESTDIR)$(PREFIX)/share/wireless-battery/lang
	rmdir --ignore-fail-on-non-empty $(DESTDIR)$(PREFIX)/share/wireless-battery 2>/dev/null || true
	rm -f $(DESTDIR)$(PREFIX)/share/applications/wireless-battery.desktop
	rm -f $(DESTDIR)$(PREFIX)/share/icons/hicolor/scalable/apps/wireless-battery.svg

clean:
	rm -rf build/linux $(TARGET)

.PHONY: clean test install uninstall
